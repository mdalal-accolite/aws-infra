# cp terraform.tfvars.stage.example terraform.tfvars   (while working on STAGE)
environment = "stage"
region      = "us-east-1"
github_org  = "ScriblOrg"
github_repo = "Infra-Scribl"

# This repo has GitHub's "immutable subject" OIDC customization enabled
# (Settings -> Actions -> General -> subject claims), which replaces the
# mutable repo:ORG/REPO prefix with repo:ORG@ORG_ID/REPO@REPO_ID. Verify
# with `gh api repos/<org>/<repo>/actions/oidc/customization/sub` before
# ever editing these - a plain repo:ORG/REPO prefix silently never matches.
plan_subjects = [
  "repo:ScriblOrg@129197376/Infra-Scribl@1371735174:pull_request",
]

# Stage auto-applies on merge to main, or via the "stage" GitHub Environment.
apply_subjects = [
  "repo:ScriblOrg@129197376/Infra-Scribl@1371735174:ref:refs/heads/main",
  "repo:ScriblOrg@129197376/Infra-Scribl@1371735174:environment:stage",
]
